# ---------------------------------------------------------------
#  نمونهٔ تنظیمات محیطی — کپی کنید به .env
#  cp .env.example .env
# ---------------------------------------------------------------

# ---------- دیتابیس ----------
# گزینهٔ ۱: Supabase یا هر پستگرس ابری
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# گزینهٔ ۲: هاست دایرکت‌ادمین / سی‌پنل (MySQL)
# DATABASE_URL=mysql://user_db:PASSWORD@localhost:3306/user_dbname

# گزینهٔ ۳: سرور شخصی
# DATABASE_URL=postgresql://hesab:PASSWORD@127.0.0.1:5432/hesab_db

# ---------- امنیت نشست ----------
# رشتهٔ تصادفی حداقل ۳۲ کاراکتر. تولید:  openssl rand -hex 32
AUTH_SECRET=

# ---------- کاربر مدیر (فقط اولین اجرا) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- اتصال به کیف پول ----------
# توکن مشترک؛ همین مقدار را در کیف پول هم قرار دهید.
WALLET_INTAKE_TOKEN=

# نگاشت شناسهٔ حساب کیف پول به شناسهٔ شریک در این نرم‌افزار
# WALLET_PARTNER_MAP={"acc_ali":"uuid-partner-1","acc_reza":"uuid-partner-2"}
WALLET_PARTNER_MAP={}

# --- اتصال کیف پول ---
# روش ساده و پیشنهادی: تطبیق بر اساس نامِ حسابِ کیف پول.
# تفاوت ی/ک عربی و فارسی، نیم‌فاصله و فاصلهٔ اضافه خودکار نادیده گرفته می‌شود.
WALLET_PARTNER_NAMES={"سرمایه سلطانی":"<uuid-شریک>","سرمایه مزینانی":"<uuid-شریک>"}

# روش جایگزین: تطبیق بر اساس شناسهٔ حساب (اگر نام‌ها عوض می‌شوند).
# هر دو با هم قابل استفاده‌اند؛ شناسه اولویت دارد.
WALLET_PARTNER_MAP={}
